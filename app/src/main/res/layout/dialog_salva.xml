<?xml version="1.0" encoding="utf-8"?>
<!-- Il salvataggio: la foto finita a tutto schermo; tenendo il dito si vede l'originale.
     Si salva sempre una COPIA nuova: l'originale non si tocca. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/confronto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Hold the photo to see the original"
        android:textColor="@color/testo_piano"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/finita"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/nero"
        android:contentDescription="Your edited photo"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/stato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="48dp"
        android:padding="8dp"
        android:text="Saves a new copy. Your original stays as it is."
        android:textColor="@color/testo"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sinistra"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Back"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/destra"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Save copy"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
