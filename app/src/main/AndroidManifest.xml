<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nessun permesso da chiedere su Android 10+: le clip arrivano dal selettore di sistema, il video
         finito va nella galleria (MediaStore, Android 10+ senza permesso). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- il microfono: solo per «+ Audio › Record your voice», chiesto quando si tocca -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="151 Editor"
        android:supportsRtl="false"
        android:theme="@style/Theme.Art">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <!-- L'editor «Audio»: solo suoni, su più corsie (come il video, in orizzontale) -->
        <activity
            android:name=".SuonoActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <!-- L'editor «Design»: volantini, post, storie -->
        <activity
            android:name=".GraficaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />
        <!-- L'editor foto: da «Edit a photo», e da Modifica / Condividi delle altre app (galleria, Storage) -->
        <activity
            android:name=".FotoActivity"
            android:exported="true"
            android:label="Edit in 151 Editor"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
